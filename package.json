{
  "name": "scroll-hint",
  "version": "1.2.10",
  "author": "steelydylan",
  "description": "JavaScript library to suggest that elements are scrollable",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/appleple/scroll-hint.git"
  },
  "bugs": {
    "url": "https://github.com/appleple/scroll-hint/issues"
  },
  "homepage": "https://github.com/appleple/scroll-hint#readme",
  "main": "./lib/index.js",
  "module": "./lib/index.mjs",
  "types": "./index.d.ts",
  "files": [
    "lib",
    "js",
    "css",
    "index.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "npm run lint && npm run test:ci",
    "test:ci": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "build": "tsup",
    "watch": "tsup --watch",
    "serve": "vite",
    "dev": "concurrently \"npm:watch\" \"npm:serve\"",
    "prepack": "npm run lint:check && npm run test:ci && npm run build",
    "release:patch": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
